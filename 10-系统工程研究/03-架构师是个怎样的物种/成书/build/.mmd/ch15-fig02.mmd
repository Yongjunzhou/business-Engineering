flowchart TB
    subgraph P["配置：它是什么样"]
        C1["配置＝相互关联的功能特性与物理特性"]
        C2["配置项＝被选定的管理单位"]
        C3["配置信息＝写下来的那些要求"]
    end
    subgraph V["版本：走到哪一步"]
        V1["版本标识：只给位置"]
        V2["变体并存，版本先后"]
    end
    subgraph B["基线：哪一份定下来"]
        B1["批准＝资格"]
        B2["冻结＝状态"]
        B3["参照＝用途"]
    end
    P --> V --> B
    B --> F["正式化：内容由技术过程形成，在某一时点由配置管理定下来"]
    F --> G["需求基线／架构基线／设计基线／产品基线"]
    G --> H["彼此要对得上：依的架构、吃的需求"]
    TR["技术过程：做内容、提名候选"] -. 候选物 .-> F
