flowchart TB
  subgraph SEQ["顺着时间切：一站接一站"]
    direction LR
    Q["需求：先弄清要成为什么<br/>第3、4、5章"] --> D["设计：需求怎么变成方案<br/>第6、7章"] --> V["把关：各对一个参照，各出一份证据<br/>第8章"] --> O["运维：上线之后，直到退役"]
  end
  subgraph CROSS["横着时间切：穿过每一站"]
    direction LR
    AR["架构：定什么、权衡什么、写什么<br/>第10~13章"]
    CF["配置：哪一版是基线<br/>第15章"]
    GV["治理：谁有资格定，按什么程序<br/>第16章"]
  end
  SEQ --> SEAMS
  CROSS --> SEAMS
  SEAMS["四种缝：承接／参照／记录／问责<br/>＋ 一张缝合清单：缝在哪两片之间、靠哪一种、谁负责"]
  SEAMS --> WHOLE["同一个系统，从出生到退役<br/>第2章的外框；第14章：架构交出去，设计接住"]
