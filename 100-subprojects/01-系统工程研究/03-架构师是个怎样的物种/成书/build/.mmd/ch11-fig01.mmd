flowchart TB
    subgraph IN["吃进什么"]
        I1["相关架构"]
        I2["组织与项目的方针与指令"]
        I3["生存周期概念与约束"]
        I4["利益相关方关切与需求"]
        I5["系统需求与约束"]
        IG["目的与目标（准绳，不在输入里）"]
    end
    IN --> F{"变换<br/>取材与综合，不是发明"}
    F --> OUT
    subgraph OUT["吐出什么"]
        O1["基本概念或属性"]
        O2["管控原则"]
        O3["（元素与关系不在这里）"]
    end
    OUT --> GO{"去向"}
    GO --> G1["分配给将要建模的实体与关系（归后文）"]
    GO --> G2["落成视图与架构描述（第13章）"]
    subgraph SPINE["从一句判断到依据"]
        S1["① 判断这个实体是什么"] --> S2["② 把它立成内容"] --> S3["③ 选定并背书（第12章；背书主体在组织侧）"] --> S4["④ 下游必须依据它（第13章）"]
    end
    subgraph SUP["素材：资产、知识与经验"]
        P1["资产：起点与素材"]
        P2["知识：能不能交给别人用"]
        P3["经验：只帮着找，不帮着选"]
        P4["都没有时：分流＋五处适配＋三条红线"]
    end
    SUP -.供给.-> F
