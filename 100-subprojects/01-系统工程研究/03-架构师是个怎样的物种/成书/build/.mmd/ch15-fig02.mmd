flowchart TB
    subgraph P["配置：它是什么样"]
        C1["配置＝相互关联的功能特性与物理特性"]
        C2["配置项＝配置之中满足某一最终使用功能的实体"]
        C3["配置信息＝关于设计、实现、验证、运行与支持的要求"]
    end
    subgraph V["版本：走到哪一步"]
        V1["版本标识：每一次改动一个号"]
        V2["只给位置，不给资格"]
    end
    subgraph B["基线：哪一版算数"]
        B1["批准＝资格"]
        B2["冻结＝状态"]
        B3["参照＝用途"]
    end
    P --> V --> B
    B --> F["正式化：内容由技术过程开发，在某一时点经配置管理过程固定"]
    F --> G["架构基线＝架构描述被选定并冻结的那一版"]
    F --> H["配置基线（内容受控）／产品基线（产品定型）"]
    G --> I["设计依从的是架构基线"]
    P -. 候选物 .-> F
